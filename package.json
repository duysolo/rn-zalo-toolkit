{
  "name": "rn-zalo-toolkit-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for rn-zalo-toolkit, the React Native native SDK for Zalo authentication",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "test": "jest",
    "doctor": "node scripts/doctor.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "check:upstream": "node scripts/check-upstream-versions.mjs",
    "check:zalosdk": "node scripts/check-zalosdk-binary.mjs",
    "vendor:sync": "node scripts/sync-vendored-zalosdk.mjs",
    "example:android": "npm run android --workspace rn-zalo-toolkit-example",
    "example:ios": "npm run ios --workspace rn-zalo-toolkit-example",
    "example:start": "npm run start --workspace rn-zalo-toolkit-example",
    "publish:main": "npm publish -w rn-zalo-toolkit"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.40.17",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
